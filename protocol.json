      "r18": true,
      "r50": true,
      "vit": true
    },
    "torch_use_deterministic_algorithms": true,
    "warn_only": false,
    "cublas_workspace_config": ":4096:8"
  },
  "eval": {
    "drs": [
      "pca",
      "tsne",
      "umap",
      "pacmap"
    ],
    "protocol": "val-fit",
    "fit_on": "val (full split)",
    "transform": "val and the full test split under the same fit; every point is stored",
    "metric_n_val": "full",
    "metric_n_test_cap": 10000,
    "subsample_rule": "np.random.RandomState(0).permutation(N)[:n]; test split only, and only for svhn",
    "tsne_impl": "openTSNE 1.0.4; the scikit-learn implementation has no transform"
  },
